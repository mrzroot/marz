  {
   "id": "google-fonts",
   "name": "Google Fonts",
   "category": "fonts",
   "impact": "medium",
   "side": "client",
   "hosts": [
    "fonts.googleapis.com",
    "fonts.gstatic.com"
   ],
   "packages": {
    "npm": [
     "webfontloader",
     "react-google-font-loader"
    ]
   },
   "why": "A render-blocking stylesheet from a Google host. Where Google is blocked the page waits for a timeout, then falls back to a system font.",
   "fa": "استایل‌شیت مسدودکنندهٔ رندر از دامنهٔ گوگل؛ جایی که گوگل مسدود است صفحه تا timeout منتظر می‌ماند.",
   "fix": "Self-host the fonts: `marz fix fonts --write` downloads the woff2 files and rewrites your <link>/@import.",
   "countries": {
    "CN": {
     "status": "degraded",
     "note": "GreatFire read the font hosts as not blocked (Sep 2026), but 21YunBox's Beijing home-line test failed every request (Aug 2026). Treat it as unreliable.",
     "sources": [
      "cwf-fonts",
      "launchready"
     ],
     "alternatives": [
      "Self-hosted fonts (marz fix fonts, Fontsource)"
     ]
    },
    "IR": {
     "status": "ok",
     "note": "Reachable from an Iranian server in the 2026-10-08 Fikaro test, but it is a Google host and has been intermittently filtered before; self-hosting removes the risk.",
     "sources": [
      "fikaro"
     ],
     "alternatives": [
      "Self-hosted Vazirmatn / Estedad / Sahel (marz fix fonts)"
     ]
    },
    "RU": {
     "status": "ok"
    }
   }
  },
